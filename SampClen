  stop("No fields found in the layout report. Verify it is a Sampling Layout Utility report.")
}

layout_df <- data.frame(
  FieldNumber = as.integer(vapply(hits, `[`, "", 2)),
  FieldName   = vapply(hits, `[`, "", 3),
  Length      = as.integer(vapply(hits, `[`, "", 4)),
  Start       = as.integer(vapply(hits, `[`, "", 5)),
  End         = as.integer(vapply(hits, `[`, "", 6)),
  stringsAsFactors = FALSE
)

layout_df <- layout_df[layout_df$Length == (layout_df$End - layout_df$Start + 1L), ]
if (nrow(layout_df) == 0) stop("No valid field definitions found in the layout report.")

