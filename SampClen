force_topmost <- function(win) {
  tcl("wm", "attributes", win, "-topmost", TRUE)
  tkraise(win)
  tkwm.deiconify(win)
  try(tcl("focus", win), silent = TRUE)
  tcl("update")
}

show_msg <- function(title, msg, icon = "info") {
  tt <- tktoplevel()
  tcl("wm", "attributes", tt, "-topmost", TRUE)
  tkwm.withdraw(tt)
  tkmessageBox(parent = tt, title = title, message = msg,
               icon = icon, type = "ok")
  tkdestroy(tt)
}

