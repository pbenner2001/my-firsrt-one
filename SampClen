# Area-code list: one 3-digit code per line
read_codes <- function(path, label) {
  x <- gsub("[^0-9]", "", readLines(path, warn = FALSE))
  x <- unique(x[nchar(x) == 3L])
  if (length(x) == 0L) stop(paste0("No 3-digit area codes found in the ", label, " file."))
  cat(sprintf("  %-22s %d codes\n", label, length(x)))
  x
}

# Phone list: returns the sample phones that appear in the list
# The list is read in chunks, so very large lists are fine.
list_hits <- function(path, label) {
  con <- file(path, "r")
  on.exit(close(con), add = TRUE)
  found   <- character(0)
  n_lines <- 0
  n_valid <- 0
  repeat {
    ln <- readLines(con, n = CHUNK_LIST, warn = FALSE)
    if (length(ln) == 0L) break
    n_lines <- n_lines + length(ln)
    tok <- sub("[,;|\t].*$", "", ln)
    d   <- gsub("[^0-9]", "", tok)
    d   <- ifelse(nchar(d) == 11L & substr(d, 1, 1) == "1", substr(d, 2, 11), d)
    ok  <- nchar(d) == 10L
    n_valid <- n_valid + sum(ok)
    h <- d[ok & (d %chin% sample_set)]
    if (length(h) > 0L) found <- unique(c(found, h))
  }
  if (n_valid == 0) {
    stop(paste0("No 10-digit phones could be read from the ", label,
                " file. Check the file format."))
  }
  cat(sprintf("  %-22s %s lines, %s phones, %s in sample\n",
              label,
              format(n_lines, big.mark = ","),
              format(n_valid, big.mark = ","),
              format(length(found), big.mark = ",")))
  found
}

#===============================================================
# REMOVAL STEPS
#===============================================================
keep        <- rep(TRUE, n)
reason_code <- character(n)
counts      <- setNames(rep(NA_integer_, length(STEP_ORDER)), STEP_ORDER)

remove_step <- function(step, flag) {
  hit <- keep & flag & !exempt
  reason_code[hit] <<- STEP_CODE[[step]]
  keep[hit]        <<- FALSE
  counts[[step]]   <<- sum(hit)
}

cat("\nReading lists...\n")

for (step in STEP_ORDER) {

  if (!cfg[[step]]$on) next

  if (step %in% c("DNC", "WDNC", "PCI", "USED")) {
    h <- list_hits(cfg[[step]]$path, STEP_LABEL[[step]])
    remove_step(step, valid10 & (phone %chin% h))
    rm(h)

  } else if (step == "NUM") {
    remove_step(step, !valid10)

  } else if (step == "TF") {
    codes <- read_codes(cfg$TF$path, "Toll free")
    remove_step(step, valid10 & (ac %chin% codes))

  } else if (step == "AKHI") {
    codes <- read_codes(cfg$AKHI$path, "AK/HI")
    remove_step(step, valid10 & (ac %chin% codes))

  } else if (step == "CAN") {
    codes <- read_codes(cfg$CAN$path, "Canadian")
    remove_step(step, valid10 & (ac %chin% codes))

  } else if (step == "AREA") {
    codes <- read_codes(cfg$AREA$path, "Valid area codes")
    remove_step(step, valid10 & !(ac %chin% codes))

  } else if (step == "DUPS") {
    d   <- rep(FALSE, n)
    idx <- which(keep & nzchar(phone))
    d[idx] <- duplicated(phone[idx])
    remove_step(step, d)
    rm(d, idx)
  }

  cat(sprintf("  Removed - %-28s %s\n",
              STEP_LABEL[[step]], format(counts[[step]], big.mark = ",")))
}

