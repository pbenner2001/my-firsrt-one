cat("\nPass 2: writing GOOD and BAD files...\n")

write_split <- function(path_in, path_good, path_bad, keep_vec, code_vec, n_expected) {
  con_in   <- file(path_in,   "r")
  con_good <- file(path_good, "w")
  con_bad  <- file(path_bad,  "w")
  on.exit({ close(con_in); close(con_good); close(con_bad) }, add = TRUE)
  pos <- 0
  repeat {
    ln <- readLines(con_in, n = CHUNK_REC, warn = FALSE, encoding = "latin1")
    if (length(ln) == 0L) break
    idx <- pos + seq_along(ln)
    k   <- keep_vec[idx]
    writeLines(ln[k], con_good, useBytes = TRUE)
    if (any(!k)) {
      writeLines(paste0(code_vec[idx][!k], " ", ln[!k]), con_bad, useBytes = TRUE)
    }
    pos <- pos + length(ln)
    cat("\r  Records processed:", format(pos, big.mark = ","))
  }
  cat("\n")
  if (pos != n_expected) stop("Record count changed between pass 1 and pass 2.")
  invisible(pos)
}

