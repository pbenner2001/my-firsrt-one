# ---- Run / Cancel ----
on_run <- function() {
  errs <- character(0)
  fw   <- trimws(tclvalue(v_fw))
  lay  <- trimws(tclvalue(v_layout))
  good <- trimws(tclvalue(v_good))
  bad  <- trimws(tclvalue(v_bad))
  pf   <- trimws(tclvalue(v_phone))

  if (!nzchar(fw)  || !file.exists(fw))  errs <- c(errs, "Select an existing fixed-width sample file.")
  if (!nzchar(lay) || !file.exists(lay)) errs <- c(errs, "Select an existing Sampling Layout Utility report.")
  if (!nzchar(pf))                       errs <- c(errs, "Enter the phone field name.")
  same <- function(x, y) {
    normalizePath(x, mustWork = FALSE) == normalizePath(y, mustWork = FALSE)
  }
  if (!nzchar(good)) errs <- c(errs, "Select the GOOD output file.")
  if (!nzchar(bad))  errs <- c(errs, "Select the BAD output file.")
  if (nzchar(good) && nzchar(bad) && same(good, bad)) {
    errs <- c(errs, "GOOD and BAD output files must be different files.")
  }
  if (nzchar(fw) && ((nzchar(good) && same(good, fw)) || (nzchar(bad) && same(bad, fw)))) {
    errs <- c(errs, "Output files cannot be the same as the input file.")
  }

  for (o in OPTS) {
    if (isTRUE(o$file) && as.integer(tclvalue(chk_vars[[o$key]])) == 1L) {
      p <- trimws(tclvalue(path_vars[[o$key]]))
      if (!nzchar(p) || !file.exists(p)) {
        errs <- c(errs, paste0("File not found for: ", o$text))
      }
    }
  }

  if (length(errs) > 0) {
    tkmessageBox(parent = win, title = "SampClen", icon = "error", type = "ok",
                 message = paste(errs, collapse = "\n"))
    return(invisible(NULL))
  }

  tclvalue(done) <- "1"
  tkdestroy(win)
}

on_cancel <- function() {
  tclvalue(done) <- "2"
  tkdestroy(win)
}

