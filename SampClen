if (length(layout_lines) == 0) stop("Layout report is empty.")

layout_pattern <-
  "^\\s*([0-9]+)\\s+([A-Za-z_][^[:space:]]*)\\s+([0-9]+)\\s+([0-9]+)-([0-9]+)(\\s|$)"

hits <- regmatches(layout_lines, regexec(layout_pattern, layout_lines))
hits <- hits[lengths(hits) == 7]

