cat("\nPass 1: reading phones...\n")

read_phones <- function(path, start, end) {
  con <- file(path, "r")
  on.exit(close(con), add = TRUE)
  out <- list()
  k <- 0L
  total <- 0
  repeat {
    ln <- readLines(con, n = CHUNK_REC, warn = FALSE, encoding = "latin1")
    if (length(ln) == 0L) break
    k <- k + 1L
    out[[k]] <- trimws(substr(ln, start, end))
    total <- total + length(ln)
    cat("\r  Records read:", format(total, big.mark = ","))
  }
  cat("\n")
  if (k == 0L) character(0) else unlist(out, use.names = FALSE)
}

phone <- read_phones(fw_file, ph_start, ph_end)

n <- length(phone)
if (n == 0L) stop("The fixed-width file is empty.")

is_blank <- !nzchar(phone)
valid10  <- grepl("^[0-9]{10}$", phone)
ac       <- substr(phone, 1, 3)
exempt   <- is_blank & KEEP_BLANK_PHONES

sample_set <- unique(phone[valid10])
cat("  Records:", format(n, big.mark = ","), "\n")
cat("  Valid 10-digit phones:", format(sum(valid10), big.mark = ","), "\n")

